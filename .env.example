# Copy this file to .env and fill in real values, then run: docker compose up --build

# Database type: mssql, postgresql or mysql (MariaDB works with mysql). Required.
# Changing it requires a rebuild: docker compose up --build
DB_TYPE=

# Database connection, username/password authentication (cloud or on-prem).
# Use a read-only login: the backend only runs SELECT queries, but the login's
# permissions are the real guarantee.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# Database (or catalog) name. Required.
DB_NAME=

# Optional. Schema to read tables from (default: dbo / public / the MySQL database).
DB_SCHEMA=

# Optional. Comma-separated tables or views to give the LLM, schema-qualified
# names allowed (e.g. dbo.Orders,dbo.Customers). Empty = every table and view
# in the schema. On large databases, list the ones you need to keep the prompt small.
DB_TABLES=

# OpenAI-compatible chat completions endpoint (llama.cpp, Ollama, cloud API, etc.)
# The backend runs in a container and reaches your host machine via host.docker.internal.
LLM_URL=http://host.docker.internal:8080/v1/chat/completions

# Model name/tag your LLM server expects (must match what it serves — an
# Ollama tag, a llama.cpp alias, a cloud provider's model ID, etc.).
# Required — the backend refuses to start if this is unset.
LLM_MODEL=

# Origins allowed to call the backend API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Base URL the frontend uses to reach the backend, baked in at build time
VITE_API_URL=http://localhost:8000

# Optional. Replace the built-in system prompt (see DEFAULT_SYSTEM_PROMPT_TEMPLATE in
# backend/main.py). Placeholders: {schema}, {db_name}, {dialect}, {dialect_rules}.
# Use a double-quoted value; newlines may be real line breaks or \n.
# SYSTEM_PROMPT_TEMPLATE=
